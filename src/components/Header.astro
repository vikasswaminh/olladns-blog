---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="docs-header">
  <div class="docs-header-inner">
    <a class="docs-brand" href="/">
      <div style="display: flex; align-items: center; gap: 6px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span class="docs-brand-logo" style="text-transform: lowercase;">olladns</span>
      </div>
      <span class="docs-brand-sub">Blog</span>
    </a>

    <nav class="docs-nav" id="mainNav">
      {NAV.map((item) => (
        <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
      <a class="docs-nav-cta" href={SITE.url}>olladns.com ↗</a>
    </nav>
  </div>
</header>
