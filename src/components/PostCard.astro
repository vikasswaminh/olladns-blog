---
import FormattedDate from './FormattedDate.astro';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: number;
  thumbnailUrl?: string;
}
const { url, title, description, pubDate, tags = [], minutes, thumbnailUrl } = Astro.props;

// Fallback image if none provided
const image = thumbnailUrl || 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=80&fm=webp';
---

<article class="post-card-new" data-title={title} data-desc={description} data-tags={tags.join(',')}>
  <a href={url}>
    <img src={image} alt={title} class="post-card-image" width="600" height="340" loading="lazy" decoding="async" />
  </a>
  <div class="post-card-content">
    {tags.length > 0 && (
      <span class="post-card-category">{tags[0]}</span>
    )}
    <h2 class="post-card-title-new"><a href={url}>{title}</a></h2>
    <p class="post-card-desc-new">{description}</p>
    
    <div class="post-card-footer">
      <div class="post-card-meta-new">
        <FormattedDate date={pubDate} />
        {minutes && <span>• {minutes} min read</span>}
      </div>
      <a href={url} class="post-card-readmore">Read →</a>
    </div>
  </div>
</article>
