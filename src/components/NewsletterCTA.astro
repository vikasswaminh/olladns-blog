---
// NewsletterCTA.astro
---

<section class="newsletter-cta">
  <div class="container">
    <h2>Stay updated with OllaDNS</h2>
    <p>Get the latest DNS, security, networking and infrastructure insights delivered to your inbox.</p>
    
    <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thanks for subscribing!');">
      <input type="email" class="newsletter-input" placeholder="Enter your work email" required />
      <button type="submit" class="newsletter-btn">Subscribe</button>
    </form>
  </div>
</section>
