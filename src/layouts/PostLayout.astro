---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '../config';
import { readingTime, getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const otherPosts = allPosts.filter(p => p.slug !== Astro.props.post?.slug);


interface Props {
  post: CollectionEntry<'blog'>;
  headings?: any[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, cover } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/${post.slug}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {author && <span aria-hidden="true">·</span>}
        {author && <span>{author}</span>}
      </p>
      {
        tags && tags.length > 0 && (
          <p class="post-tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>
                #{t}
              </a>
            ))}
          </p>
        )
      }
    </header>
    {cover && <Image class="post-cover" src={cover} alt="" inferSize={true} loading="lazy" decoding="async" />}

    <div class="post-content-layout" style="margin-top: 0.75rem;">

      <!-- Left Sidebar: All Blog Posts -->
      <aside class="left-navigation-sidebar">
        <p class="sidebar-label">ALL BLOG POSTS</p>
        <ul class="sidebar-post-list">
          {otherPosts.map((p) => (
            <li><a href={`/${p.slug}/`}>{p.data.title}</a></li>
          ))}
        </ul>
      </aside>

      <!-- Center: Main Article -->
      <div class="prose">
        <slot />
      </div>

      <!-- Right Sidebar: OllaDNS Navigation Links -->
      <aside class="right-navigation-sidebar">
        <p class="sidebar-label">OLLADNS</p>
        <ul class="sidebar-links-list">
          <li>
            <a href="https://olladns.com">
              <h4>OllaDNS Homepage</h4>
              <p>Explore the OllaDNS platform and products</p>
            </a>
          </li>
          <li>
            <a href="/">
              <h4>OllaDNS Blog</h4>
              <p>Follow the OllaDNS blog for the latest insights and news</p>
            </a>
          </li>
          <li>
            <a href="https://olladns.com/products">
              <h4>Protective DNS Platform</h4>
              <p>Block threats at the DNS resolver level</p>
            </a>
          </li>
          <li>
            <a href="https://olladns.com/solutions">
              <h4>Industry Solutions</h4>
              <p>Tailored DNS security for every sector</p>
            </a>
          </li>
          <li>
            <a href="https://olladns.com/pricing">
              <h4>Plans &amp; Pricing</h4>
              <p>Find the right plan for your organisation</p>
            </a>
          </li>
          <li>
            <a href="https://olladns.com/docs">
              <h4>Documentation</h4>
              <p>Setup guides, API references &amp; more</p>
            </a>
          </li>
        </ul>
      </aside>

    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* ── Sidebar: sticky with solid background ── */
  .left-navigation-sidebar,
  .right-navigation-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .left-navigation-sidebar,
    .right-navigation-sidebar {
      display: block;
      position: sticky;
      top: 90px;
      background-color: var(--bg, #ffffff);
      z-index: 5;
      align-self: start;
    }
  }

  /* Red pill label */
  .sidebar-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    background: var(--accent, #DA291C);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    white-space: nowrap;
  }

  /* Left sidebar: blog post list */
  .sidebar-post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-post-list li a {
    display: block;
    font-size: 0.88rem;
    color: var(--text, #1a1f29);
    font-weight: 500;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    line-height: 1.45;
    transition: color 0.15s, background 0.15s;
  }

  .sidebar-post-list li a:hover {
    color: var(--accent, #DA291C);
    background: rgba(218, 41, 28, 0.05);
  }

  /* Right sidebar: OllaDNS links */
  .sidebar-links-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sidebar-links-list li a {
    display: block;
    text-decoration: none;
    padding: 8px 10px;
    border-radius: 6px;
    transition: background 0.15s;
  }

  .sidebar-links-list li a:hover {
    background: rgba(218, 41, 28, 0.05);
  }

  .sidebar-links-list li a:hover h4 {
    color: var(--accent, #DA291C);
  }

  .sidebar-links-list h4 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text, #1a1f29);
    line-height: 1.4;
  }

  .sidebar-links-list p {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--muted, #667085);
    line-height: 1.4;
  }
</style>
