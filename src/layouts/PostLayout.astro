---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE } from '../config';
import { readingTime, getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const otherPosts = allPosts.filter(p => p.slug !== Astro.props.post?.slug);


interface Props {
  post: CollectionEntry<'blog'>;
  headings?: any[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, cover } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/${post.slug}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {author && <span aria-hidden="true">·</span>}
        {author && <span>{author}</span>}
      </p>
      {
        tags && tags.length > 0 && (
          <p class="post-tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>
                #{t}
              </a>
            ))}
          </p>
        )
      }
    </header>
    {cover && <Image class="post-cover" src={cover} alt="" inferSize={true} loading="lazy" decoding="async" />}

    <div class="post-content-layout">

      <!-- Left Sidebar: All Blog Posts -->
      <aside class="left-navigation-sidebar">
        <p class="sidebar-label">ALL BLOG POSTS</p>
        <div class="sidebar-card-list">
          {otherPosts.map((p) => (
            <a href={`/${p.slug}/`} class="sidebar-card">
              <h4>{p.data.title}</h4>
            </a>
          ))}
        </div>
      </aside>

      <!-- Center: Main Article -->
      <div class="prose">
        <slot />
      </div>

      <!-- Right Sidebar: OllaDNS Navigation Links -->
      <aside class="right-navigation-sidebar">
        <p class="sidebar-label">OLLADNS</p>
        <div class="sidebar-card-list">
          <a href="https://olladns.com" class="sidebar-card sidebar-card--link">
            <h4>OllaDNS Homepage</h4>
            <p class="sidebar-card-desc">Explore the OllaDNS platform and products</p>
          </a>
          <a href="https://olladns.com/products" class="sidebar-card sidebar-card--link">
            <h4>Protective DNS Platform</h4>
            <p class="sidebar-card-desc">Block threats at the DNS resolver level</p>
          </a>
          <a href="https://olladns.com/solutions" class="sidebar-card sidebar-card--link">
            <h4>Industry Solutions</h4>
            <p class="sidebar-card-desc">Tailored DNS security for every sector</p>
          </a>
          <a href="https://olladns.com/pricing" class="sidebar-card sidebar-card--link">
            <h4>Plans &amp; Pricing</h4>
            <p class="sidebar-card-desc">Find the right plan for your organisation</p>
          </a>
          <a href="https://olladns.com/docs" class="sidebar-card sidebar-card--link">
            <h4>Documentation</h4>
            <p class="sidebar-card-desc">Setup guides, API references &amp; more</p>
          </a>
        </div>
      </aside>

    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* ── Sidebar: sticky with solid background, no height cramping ── */
  .left-navigation-sidebar,
  .right-navigation-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .left-navigation-sidebar,
    .right-navigation-sidebar {
      display: block;
      position: sticky;
      top: 90px;
      /* Solid background so article text never bleeds through */
      background-color: var(--bg, #ffffff);
      z-index: 5;
      /* NO max-height / overflow-y — cards spread out naturally, never squish */
      align-self: start;
    }
  }

  /* Pill label */
  .sidebar-label {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    background: var(--accent, #DA291C);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    white-space: nowrap;
  }

  /* Card list */
  .sidebar-card-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Cards */
  .sidebar-card {
    display: block;
    background-color: var(--bg, #ffffff);
    border: 1px solid var(--border, #e6e8ec);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    color: var(--text, #1a1f29);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .sidebar-card:hover {
    border-color: var(--accent, #DA291C);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .sidebar-card h4 {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
    color: var(--text, #1a1f29);
  }

  .sidebar-card:hover h4 {
    color: var(--accent, #DA291C);
  }

  .sidebar-card-desc {
    font-size: 0.78rem;
    color: var(--muted, #667085);
    margin: 0.2rem 0 0;
    line-height: 1.4;
  }
</style>
