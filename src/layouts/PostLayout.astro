---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE } from '../config';
import { readingTime, getPublishedPosts } from '../utils/posts';

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.filter(p => p.slug !== Astro.props.post?.slug).slice(0, 5);

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: any[];
}
const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, cover } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/${post.slug}/`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {author && <span aria-hidden="true">·</span>}
        {author && <span>{author}</span>}
      </p>
      {
        tags && tags.length > 0 && (
          <p class="post-tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>
                #{t}
              </a>
            ))}
          </p>
        )
      }
    </header>
    {cover && <img class="post-cover" src={cover} alt="" loading="lazy" />}
    
    <div class="post-content-layout">
      {headings && headings.length > 0 && <TableOfContents headings={headings} />}
      <div class="prose">
        <slot />
      </div>
      <aside class="recent-posts-sidebar">
        <h3 class="recent-posts-title">RECENT POSTS</h3>
        <div class="recent-posts-list">
          {recentPosts.map(p => (
            <a href={`/${p.slug}/`} class="recent-post-card">
              <h4>{p.data.title}</h4>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
