---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts, readingTime } from '../utils/posts';
import { SITE } from '../config';

const posts = await getPublishedPosts();
const featured = posts[0];
const rest = posts.slice(1);
const allTags = ['All', ...new Set(posts.flatMap((p) => p.data.tags || []))].filter(Boolean);

// Fallback images based on tags - Simple and professional
function getFallbackImage(tags: string[]) {
  const t = tags.join(' ').toLowerCase();
  if (t.includes('security') || t.includes('ddos')) return 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=800&q=80';
  if (t.includes('dns') || t.includes('network') || t.includes('anycast')) return 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=800&q=80';
  if (t.includes('cloud')) return 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80';
  return 'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=800&q=80'; // generic tech
}
---

<BaseLayout wide={true}>
  <!-- MINIMAL BLOG TITLE -->
  <section class="docs-title-section">
    <span class="docs-label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
      OLLADNS BLOG
    </span>
    <h1 class="docs-title">Insights for the Modern <span class="docs-title-highlight">Internet</span></h1>
    <p class="docs-subtitle">Explore practical guides, technical insights and updates on DNS, DNSSEC, networking, cybersecurity and internet infrastructure.</p>
    <div class="docs-cat-line">
      <span class="docs-cat-pill">DNS</span>
      <span class="docs-cat-pill">DNSSEC</span>
      <span class="docs-cat-pill">Networking</span>
      <span class="docs-cat-pill">Security</span>
      <span class="docs-cat-pill">Cloud</span>
    </div>
  </section>

  <!-- 3-COLUMN LAYOUT -->
  <main class="docs-container">
    
    <!-- LEFT SIDEBAR: Latest Posts -->
    <aside class="docs-left-sidebar">
      <div class="sidebar-card">
        <div class="sidebar-pill">ALL BLOG POSTS</div>
        <div class="sidebar-post-list">
          {posts.slice(0, 7).map((p) => (
            <a href={`/blog/${p.slug}/`} class="sidebar-post-item">
              {p.data.title}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <!-- CENTER CONTENT -->
    <div class="docs-center">
      
      <!-- FEATURED ARTICLE -->
      {featured && (
        <a href={`/blog/${featured.slug}/`} class="docs-featured-card">
          <span class="docs-featured-label">Featured Article</span>
          <img src={featured.data.cover || getFallbackImage(featured.data.tags || [])} alt="" class="docs-featured-img" />
          <span class="docs-featured-tag">{featured.data.tags?.[0] || 'Guides'}</span>
          <h2 class="docs-featured-title">{featured.data.title}</h2>
          <p class="docs-featured-desc">{featured.data.description}</p>
          <div class="docs-meta">
            <span class="docs-author">{featured.data.author || 'OllaDNS Team'}</span>
            <span>•</span>
            <FormattedDate date={featured.data.pubDate} />
            <span>•</span>
            <span>{readingTime(featured.body)} min read</span>
          </div>
          <span class="docs-read-more">Read Article →</span>
        </a>
      )}

      <!-- SEARCH & FILTER -->
      <div class="docs-controls" id="all">
        <div class="docs-search-wrapper">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="blogSearch" class="docs-search" placeholder="Search articles..." />
        </div>
        <div class="docs-filters">
          {allTags.map(tag => (
            <button class:list={['docs-filter-btn', { active: tag === 'All' }]} data-tag={tag}>{tag}</button>
          ))}
        </div>
      </div>

      <!-- LATEST ARTICLES -->
      <h3 class="docs-section-title">Latest Articles</h3>
      <div class="docs-article-list" id="blogList">
        {rest.map((p) => (
          <a href={`/blog/${p.slug}/`} class="docs-article-card" data-title={p.data.title.toLowerCase()} data-tags={(p.data.tags || []).join(',')}>
            <img src={p.data.cover || getFallbackImage(p.data.tags || [])} alt="" class="docs-card-img" />
            <div class="docs-article-content">
              <span class="docs-article-tag">{p.data.tags?.[0] || 'Updates'}</span>
              <h4 class="docs-article-title">{p.data.title}</h4>
              <p class="docs-article-desc">{p.data.description}</p>
              <div class="docs-meta-small">
                <span><FormattedDate date={p.data.pubDate} /> • {readingTime(p.body)} min</span>
                <span class="docs-read-arrow">Read →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div id="noResults" style="display:none; padding: 2rem; text-align: center; color: var(--muted); border: 1px solid var(--border); border-radius: 6px;">
        No articles found.
      </div>

    </div>

    <!-- RIGHT SIDEBAR -->
    <aside class="docs-right-sidebar">
      <div class="docs-promo">
        <h3 class="docs-promo-title">OLLADNS</h3>
        <p class="docs-promo-desc">Building reliable DNS and internet infrastructure.</p>
        <a href={SITE.url} class="docs-promo-btn">Visit OllaDNS →</a>
      </div>

      <h3 class="docs-sidebar-heading" style="margin-top: 2rem;">Latest Posts</h3>
      <div class="docs-toc-list">
        {posts.slice(0,5).map((p, i) => (
          <a href={`/blog/${p.slug}/`} class="docs-toc-item">
            <span class="docs-toc-num">{i+1}.</span>
            <span class="docs-toc-text">{p.data.title}</span>
          </a>
        ))}
      </div>

      <h3 class="docs-sidebar-heading">Categories</h3>
      <div class="docs-topic-list">
        <a href="/tags/dns" class="docs-topic-item">DNS</a>
        <a href="/tags/dnssec" class="docs-topic-item">DNSSEC</a>
        <a href="/tags/networking" class="docs-topic-item">Networking</a>
        <a href="/tags/security" class="docs-topic-item">Cybersecurity</a>
        <a href="/tags/cloud" class="docs-topic-item">Cloud</a>
      </div>
    </aside>

  </main>
</BaseLayout>

<script>
  const searchInput = document.getElementById('blogSearch') as HTMLInputElement;
  const categoryBtns = document.querySelectorAll('.docs-filter-btn');
  const articles = document.querySelectorAll('.docs-article-card');
  const noResults = document.getElementById('noResults');
  
  let currentTag = 'All';
  let searchQuery = '';

  function filter() {
    let count = 0;
    articles.forEach(el => {
      const art = el as HTMLElement;
      const title = art.dataset.title || '';
      const tags = art.dataset.tags || '';
      const matchSearch = title.includes(searchQuery);
      const matchTag = currentTag === 'All' || tags.includes(currentTag);
      if (matchSearch && matchTag) {
        art.style.display = '';
        count++;
      } else {
        art.style.display = 'none';
      }
    });
    if (noResults) noResults.style.display = count === 0 ? 'block' : 'none';
  }

  if (searchInput) {
    searchInput.addEventListener('input', e => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filter();
    });
  }

  categoryBtns.forEach(btn => {
    btn.addEventListener('click', e => {
      categoryBtns.forEach(b => b.classList.remove('active'));
      const target = e.target as HTMLElement;
      target.classList.add('active');
      currentTag = target.dataset.tag || 'All';
      filter();
    });
  });
</script>
