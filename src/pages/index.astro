---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, readingTime } from '../utils/posts';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';

const posts = await getPublishedPosts();
const featured = posts[0];
const rest = posts.slice(1);
---

<BaseLayout title="Blog - Networking & Cloud Security" wide={true}>
  
  <div class="super-blog-layout container">
    
    <!-- Left Sidebar: All Blog Posts -->
    <aside class="super-sidebar">
      <div class="sidebar-header" style="margin-bottom: 0.5rem; display: flex; align-items: center; height: 32px;">
        <span class="badge-accent">ALL BLOG POSTS</span>
      </div>
      <ul class="sidebar-post-list">
        {posts.map((p) => (
          <li>
            <a href={`/${p.slug}/`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    </aside>

    <!-- Main Content -->
    <main class="super-main-content">

      <div class="sidebar-header" style="margin-bottom: 0.5rem; display: flex; align-items: center; height: 32px; gap: 1rem;">
        <span class="badge-accent">NEWEST ARTICLES</span>
        <span class="super-divider-text">Latest from our experts</span>
      </div>

      {featured && (
        <a href={`/${featured.slug}/`} class="super-featured-card">
          <div class="super-featured-image">
            <Image src={featured.data.image?.url || "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&fm=webp&w=900"} alt={featured.data.title} width={900} height={506} inferSize={true} fetchpriority="high" decoding="async" />
          </div>
          <div class="super-featured-content">
            <span class="badge-premium badge-orange mb-3" style="align-self: flex-start;">{featured.data.tags[0] || 'AI WORKFORCE'}</span>
            <h2 class="super-featured-title">{featured.data.title}</h2>
            <p class="super-featured-desc">{featured.data.description}</p>
            <div class="super-featured-meta">
              <FormattedDate date={featured.data.pubDate || new Date()} />
              <span class="meta-dot">•</span>
              <span class="read-more-link">Read article <span class="arrow">→</span></span>
            </div>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="super-article-list">
          {rest.map((p) => (
            <article class="super-article-card-vertical">
               <a href={`/${p.slug}/`} style="text-decoration: none; color: inherit; display: flex; flex-direction: column; height: 100%;">
                 <div class="super-article-content" style="flex: 1; display: flex; flex-direction: column;">
                    <span class="badge-accent mb-2" style="font-size: 0.65rem; padding: 0.25rem 0.6rem; align-self: flex-start;">{p.data.tags[0] || 'Article'}</span>
                    <h3 class="super-article-title">{p.data.title}</h3>
                    <p class="super-article-desc">{p.data.description}</p>
                    <div class="super-featured-meta" style="margin-top: auto;">
                      <FormattedDate date={p.data.pubDate || new Date()} />
                    </div>
                 </div>
               </a>
            </article>
          ))}
        </div>
      )}
    </main>

    <!-- Right Sidebar -->
    <aside class="super-sidebar">
      <div class="sidebar-header" style="margin-bottom: 1.5rem; display: flex; align-items: center; height: 32px;">
        <span class="badge-accent">OLLADNS</span>
      </div>
      <ul class="sidebar-links-list">
        <li>
          <a href="#">Return to the main OllaDNS homepage to see everything.</a>
        </li>
        <li>
          <a href="#">Explore the autonomous platform that powers AI work.</a>
        </li>
        <li>
          <a href="#">Meet your new AI employee workforce and see them in action.</a>
        </li>
        <li>
          <a href="#">Discover industry-specific solutions tailored for your business.</a>
        </li>
        <li>
          <a href="#">Read our comprehensive guides and educational resources.</a>
        </li>
        <li>
          <a href="#">Follow the OllaDNS blog for the latest insights and news.</a>
        </li>
      </ul>
    </aside>

  </div>
</BaseLayout>

